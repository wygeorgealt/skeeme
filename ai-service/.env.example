# Skeeme AI Service Environment
# Copy this to .env and fill in values

# Server
PORT=3001

# Anthropic API Key (same one you use in Laravel)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Laravel Backend URL (your Herd local URL)
LARAVEL_API_URL=http://skeeme.test/api

# Internal shared secret (must match the one in Laravel .env)
INTERNAL_SECRET=skeeme-ai-secret-key-123
