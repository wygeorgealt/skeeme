{
  "expo": {
    "name": "Skeeme",
    "slug": "skeeme",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skeeme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skeeme.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Skeeme uses the camera to scan questions or flashcard source material for AI solving.",
        "NSPhotoLibraryUsageDescription": "Skeeme accesses your photos to select existing question images for scanning.",
        "NSPhotoLibraryAddUsageDescription": "Skeeme needs permission to save generated PDFs and exported flashcards to your library.",
        "NSUserTrackingUsageDescription": "Skeeme uses this to provide personalized educational content and diagnostic crash reporting."
      }
    },
    "android": {
      "package": "com.skeeme.app",
      "versionCode": 10,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#100921",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#100921"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#100921"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "blockedPermissions": [
              "android.permission.ACTIVITY_RECOGNITION",
              "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
            ]
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Skeeme uses the camera to scan questions or flashcard source material for AI solving.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Skeeme accesses your photos to select existing question images for scanning."
        }
      ],
      "expo-secure-store",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "299bfccb-a625-4a0c-885d-f9e6c4369396"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yeezykng_dom",
    "updates": {
      "url": "https://u.expo.dev/299bfccb-a625-4a0c-885d-f9e6c4369396"
    }
  }
}