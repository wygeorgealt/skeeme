{
  "expo": {
    "name": "Skeeme",
    "slug": "skeeme",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skeeme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kantrol.skeeme",
      "infoPlist": {
        "NSCameraUsageDescription": "Skeeme uses the camera to scan questions for AI solving.",
        "NSPhotoLibraryUsageDescription": "Skeeme accesses your photos to select question images for scanning.",
        "NSUserTrackingUsageDescription": "Skeeme uses this to provide personalized educational content and diagnostic crash reporting."
      }
    },
    "android": {
      "package": "com.kantrol.skeeme",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#100921",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#100921",
        "dark": {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#100921"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#100921"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "299bfccb-a625-4a0c-885d-f9e6c4369396"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yeezykng_dom",
    "updates": {
      "url": "https://u.expo.dev/299bfccb-a625-4a0c-885d-f9e6c4369396"
    }
  }
}
