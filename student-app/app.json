{
  "expo": {
    "name": "Skeeme",
    "slug": "skeeme",
    "version": "1.2.5",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "skeeme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skeeme.app",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Skeeme uses the camera to scan questions or flashcard source material for AI solving.",
        "NSPhotoLibraryUsageDescription": "Skeeme accesses your photos to select existing question images for scanning.",
        "NSPhotoLibraryAddUsageDescription": "Skeeme needs permission to save generated PDFs and exported flashcards to your library.",
        "NSUserTrackingUsageDescription": "Skeeme uses this to provide personalized educational content and diagnostic crash reporting."
      }
    },
    "android": {
      "package": "com.skeeme.app",
      "versionCode": 21,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#007AFF",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#0D0D0D"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "blockedPermissions": [
              "android.permission.ACTIVITY_RECOGNITION",
              "com.google.android.gms.permission.ACTIVITY_RECOGNITION",
              "android.permission.RECORD_AUDIO"
            ],
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Skeeme uses the camera to scan questions or flashcard source material for AI solving.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Skeeme accesses your photos to select existing question images for scanning."
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66791392-9f56-438c-ac13-594d2b47fafc"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "george.allday",
    "updates": {
      "url": "https://u.expo.dev/66791392-9f56-438c-ac13-594d2b47fafc"
    }
  }
}
