# ===========================================================================
# Skeeme .gitignore — Go Backend + Expo Mobile + AI Service
# ===========================================================================

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Environment ────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Go Backend (skeeme-go/) ────────────────────────────────────────────────
skeeme-go/tmp/
skeeme-go/*.exe
skeeme-go/*.out
skeeme-go/*.test

# ── Mobile App (student-app/) ──────────────────────────────────────────────
student-app/node_modules/
student-app/dist/
student-app/.expo/

# ── AI Service (ai-service/) ──────────────────────────────────────────────
ai-service/node_modules/

# ── Landing Page (when created) ───────────────────────────────────────────
landing/node_modules/
landing/dist/

# ── Dump (legacy code preserved for audit) ─────────────────────────────────
_dump/node_modules/
_dump/vendor/

# ── IDE ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
