# ===========================================================================
# Skeeme Environment Variables
# Go Backend (skeeme-go) Configuration
# ===========================================================================

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=
# OR individual vars:
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=skeeme

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=local

# ── Internal Service Secret (AI Service ↔ Go Backend) ──────────────────────
INTERNAL_API_SECRET=

# ── Email (Resend API for OTPs) ────────────────────────────────────────────
RESEND_API_KEY=

# ── Payments (Paystack) ───────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ── Cloud Storage (Cloudflare R2) ─────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
